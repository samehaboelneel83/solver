{
  "//": [
    "THE GENUI PROTOCOL -- one artefact, read by both languages.",
    "",
    "What an agent may say to the interface: which components exist, the",
    "states a component passes through, the agent's own states, and the",
    "events a stream carries. It says nothing about React: the browser",
    "renders a component type through its own registry, and nothing the",
    "agent sends is ever code. `frontend/src/genui/protocol/parity.test.ts`",
    "deep-compares this file with `frontend/src/genui/protocol/types.ts`.",
    "",
    "Numbers in a component's data come from the platform (a run, its",
    "events, its record), never from a language model: an agent chooses",
    "what to show, not what the solver found."
  ],
  "version": 1,
  "componentTypes": [
    "metric",
    "optimization-summary",
    "solver-status",
    "solver-progress",
    "model-summary",
    "variable-editor",
    "constraint-builder",
    "objective-editor",
    "expression-builder",
    "query-builder",
    "data-table",
    "chart",
    "solution-table",
    "scenario-comparison",
    "sensitivity-analysis",
    "solver-log",
    "validation-result",
    "confirmation",
    "timeline"
  ],
  "componentStates": ["skeleton", "hydrating", "hydrated", "interactive", "error"],
  "agentStates": [
    "idle",
    "understanding",
    "planning",
    "loading_data",
    "building_model",
    "validating_model",
    "generating_expressions",
    "selecting_solver",
    "submitting_job",
    "solving",
    "post_processing",
    "hydrating_ui",
    "complete",
    "warning",
    "error"
  ],
  "events": [
    "agent.state",
    "agent.message",
    "component.created",
    "component.updated",
    "component.data",
    "component.action",
    "component.completed",
    "component.error"
  ]
}
