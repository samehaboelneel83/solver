    { "code": "constraint_weight_invalid", "loc": ["constraints", 0, "weight"], "why": "a soft constraint with no penalty is a constraint the solver is free to ignore, which is a disable nobody asked for", "ir": { "version": 1, "sets": [], "parameters": {}, "variables": { "x": { "index": [], "domain": "binary" } }, "constraints": [{ "id": "c_one", "left": { "var": "x", "index": [] }, "relation": "<=", "right": { "const": 1 }, "severity": "soft" }] } },

