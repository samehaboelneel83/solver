# Copy to .env (same folder) and adjust.

# --- Your LLM (vLLM, OpenAI-compatible) ---
LLM_BASE_URL=http://10.125.18.189:8000/v1
LLM_MODEL=qwen3.5
LLM_API_KEY=EMPTY
LLM_CONTEXT=32768
LLM_MAX_TOKENS=4096
LLM_TEMPERATURE=0.2
# Qwen thinking: on | off | (blank = server default). "off" is faster and saves context.
LLM_THINKING=
# auto | native | text   (auto detects whether vLLM has tool calling enabled)
LLM_TOOL_MODE=auto

# --- The solver platform backend ---
SOLVER_URL=http://localhost:8010
# Either an API key made on the API Keys page (sk_...) ...
SOLVER_API_KEY=
# ... or a username/password (used when SOLVER_API_KEY is blank)
SOLVER_USERNAME=admin
SOLVER_PASSWORD=change-me-admin

# --- Agent behaviour ---
# Which calls need your OK first: none | delete | write (write = every non-GET call)
AGENT_CONFIRM=delete
AGENT_MAX_STEPS=40
AGENT_TOOL_RESULT_CHARS=8000
AGENT_WEB_PORT=8020
# 127.0.0.1 = this PC only; 0.0.0.0 = anyone on your network can use the agent as you
AGENT_WEB_HOST=127.0.0.1
