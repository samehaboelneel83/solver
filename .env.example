# The Assistant (docs/assistant.md): an OpenAI-compatible model server (vLLM).
AGENT_ENABLED=1
LLM_BASE_URL=http://10.125.18.189:8000/v1
LLM_MODEL=qwen3.5
LLM_API_KEY=EMPTY
LLM_CONTEXT=32768
# on | off | blank (the server's default) -- Qwen's thinking
LLM_THINKING=
# delete (ask before deleting) | write (ask before every change) | none
AGENT_CONFIRM=delete
# 1 lets the Assistant run Python it writes; keep off unless an administrator
# has reviewed the sandbox's network-isolation limits (docs/assistant.md).
AGENT_RUN_PYTHON=0
