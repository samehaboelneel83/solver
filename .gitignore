.worktrees/
.env
# The runtime role's URL and password (scripts/runtime_role.sh).
.env.runtime
__pycache__/
*.pyc
.venv/
node_modules/
dist/
# Generated digest pins (OAAS O04); regenerate with scripts/render-digest-compose.sh
deploy/compose/docker-compose.digests.yml
.pytest_cache/
*.tsbuildinfo

# Superpowers SDD workspace: ledgers, briefs, task reports and review diffs.
# Local working record, not project history (review diffs are regenerable from git).
.superpowers/

# One-off browser checks written while verifying a change in a real browser
# (Playwright scripts named `_browser_check_*.mjs`). They drive the live stack
# with fixed ids and are not part of the test suite; kept locally, never
# committed by accident.
frontend/_browser_check_*.mjs
# Screenshots / CSVs captured while checking the live UI in a browser.
frontend/_shots/
# One-off backend probes, same idea.
backend/_probe_*.py

# MIPLIB instances are downloaded by `python -m bench.download_miplib`, not committed.
backend/bench/mps/

# Nightly job output (scripts/nightly.sh).
backend/bench/nightly_results/

# Local backup tree when someone points SOLVER_BACKUP_DIR inside the repo.
# The default is a sibling ../solver-backups/ (outside git).
solver-backups/
**/solver-backups/

# solver agent
agent/.env
agent/logs/
.agent_tmp/
.vitest-cache/

# Local scratch: rebuild watcher state, logs, test-driver output, editor and Vite leftovers
/.claude/
/FETCH_HEAD
/git
/*.log
/rebuild.status
/rebuild.request
/assistant-browser-test-*.jpg
/general_assistant_kit.zip
frontend/vite.config.ts.timestamp-*.mjs
samples/alex-flood-usertest/_transfer/
agent-test/old/
agent-test/*.txt
agent-test/*.log
agent-test/turn.json
agent-test/*.dxf
